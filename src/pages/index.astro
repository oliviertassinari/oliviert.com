---
import Home from '../components/Home';
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>Olivier Tassinari — Building UI tooling</title>
		<meta
			name="description"
			content="Olivier Tassinari is CEO & Co-founder at MUI."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Olivier Tassinari — Building UI tooling" />
		<meta property="og:url" content="https://oliviert.com/" />
		<meta
			property="og:description"
			content="Olivier Tassinari is CEO & Co-founder at MUI."
		/>
		<meta property="og:image" content="https://oliviert.com/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@olivtassinari" />
		<meta name="twitter:title" content="Olivier Tassinari — Building UI tooling" />
		<meta
			name="twitter:description"
			content="Olivier Tassinari is CEO & Co-founder at MUI."
		/>
		<meta name="twitter:image" content="https://oliviert.com/og.png" />
    <script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Person",
						"@id": "https://oliviert.com/#person",
						"name": "Olivier Tassinari",
						"url": "https://oliviert.com/",
						"image": "https://oliviert.com/olivier.jpg",
						"jobTitle": "CEO & Co-founder at MUI",
						"description": "Building UI tooling.",
						"worksFor": { "@id": "https://mui.com/#organization" },
						"knowsAbout": ["React", "User interfaces", "Open source", "Design systems"],
						"sameAs": [
							"https://github.com/oliviertassinari",
							"https://x.com/olivtassinari",
							"https://www.linkedin.com/in/olivier-tassinari/"
						]
					},
					{
						"@type": "Organization",
						"@id": "https://mui.com/#organization",
						"name": "MUI",
						"url": "https://mui.com/"
					},
					{
						"@type": "WebSite",
						"@id": "https://oliviert.com/#website",
						"url": "https://oliviert.com/",
						"name": "Olivier Tassinari",
						"inLanguage": "en",
						"publisher": { "@id": "https://oliviert.com/#person" }
					},
					{
						"@type": "ProfilePage",
						"@id": "https://oliviert.com/#webpage",
						"url": "https://oliviert.com/",
						"name": "Olivier Tassinari — Building UI tooling",
						"isPartOf": { "@id": "https://oliviert.com/#website" },
						"about": { "@id": "https://oliviert.com/#person" },
						"mainEntity": { "@id": "https://oliviert.com/#person" }
					}
				]
			}
		</script>
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('theme');
					const prefersDark = window.matchMedia(
						'(prefers-color-scheme: dark)',
					).matches;
					if (saved === 'dark' || (!saved && prefersDark)) {
						document.documentElement.classList.add('dark');
					}
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<Home client:load />
	</body>
</html>
